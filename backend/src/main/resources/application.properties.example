spring.application.name=backend
app.name=BiciklRent

# ---------- Baza podataka ----------
spring.datasource.url=jdbc:mysql://localhost:3306/njtbicikl
spring.datasource.username=TVOJ_MYSQL_USERNAME
spring.datasource.password=TVOJA_MYSQL_LOZINKA
spring.jpa.hibernate.ddl-auto=none

# ---------- JWT ----------
jwt.secret=GENERISI_DUGACAK_SLUCAJAN_STRING_MIN_32_KARAKTERA
jwt.expiration-ms=3600000

# ---------- Email (Gmail SMTP) ----------
# Ukljuci 2FA i generisi App Password na myaccount.google.com/apppasswords
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=TVOJ_EMAIL@gmail.com
spring.mail.password=TVOJ_APP_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true